<?xml version="1.0" encoding="UTF-8"?>
<mujoco model="Heuristic-01">

  <compiler angle="radian" 
            coordinate="local" 
            meshdir="../meshes" 
            autolimits="true"/>

  <option timestep="0.005" 
          gravity="0 0 -9.81" 
          integrator="implicitfast"/>

  <default>
    <geom contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="right_wheel_link" file="right_wheel_link.STL"/>
    <mesh name="left_wheel_link" file="left_wheel_link.STL"/>
    <mesh name="caster_link" file="caster_link.STL"/>
    <mesh name="tof_front_link" file="tof_front_link.STL"/>
    <mesh name="tof_left_link" file="tof_left_link.STL"/>
    <mesh name="tof_right_link" file="tof_right_link.STL"/>
    <mesh name="imu_link" file="imu_link.STL"/>

    <texture type="skybox"
             builtin="gradient"
             rgb1="0.5 0.7 1"
             rgb2="0.95 0.95 1"
             width="256"
             height="256"/>

    <!-- Use built-in checker pattern to create grid texture -->
    <texture name="grid"
             type="2d"
             builtin="checker"
             rgb1="0.2 0.3 0.4"
             rgb2="0.3 0.4 0.5"
             width="256"
             height="256"
             mark="cross"
             markrgb="0.8 0.8 0.8"/>

    <!-- Create a grid material from the grid texture  -->
    <material name="grid"
              texture="grid"
              texrepeat="5 5"
              reflectance="0"
              specular="0"
              shininess="0"/>
  </asset>

  <!-- Prevent chassis-to-wheel mesh overlap from causing physics instabilities -->
  <contact>
    <exclude body1="robot_base" body2="left_wheel_link"/>
    <exclude body1="robot_base" body2="right_wheel_link"/>
  </contact>

  <worldbody>

    <site name="target_waypoint" type="sphere" size="0.05" rgba="1 0 0 1" pos="0 0 0.05"/>
    <light pos="0 0 12" 
           dir="0 0 -1" 
           diffuse="0.8 0.8 0.8"/>
    <geom name="floor" 
          type="plane" 
          size="5 5 0.1" 
          material="grid"/>
    
    <!-- Main Robot Body -->
    <body name="robot_base" pos="0 0.05 0.05">
      <freejoint/>

      <!-- Static Base Geoms -->
      <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="base_link"/>
      <geom pos="0.075206 -0.0514149 0.0329529" quat="0.5 0.5 0.5 0.5" type="mesh" rgba="0.1 0.1 0.1 1" mesh="tof_front_link"/>
      <geom pos="0.064132 -0.0154935 0.0329529" quat="0.331967 0.331967 0.624338 0.624338" type="mesh" rgba="0.1 0.1 0.1 1" mesh="tof_left_link"/>
      <geom pos="0.0642998 -0.0873876 0.0329529" quat="0.624338 0.624338 0.331967 0.331967" type="mesh" rgba="0.1 0.1 0.1 1" mesh="tof_right_link"/>
      <geom pos="-0.180386 -0.0764647 0.0707029" quat="0.707107 0.707107 0 0" type="mesh" rgba="0.1 0.1 0.1 1" mesh="imu_link"/>

      <site name="imu_site" 
            type="box"
            pos="0.0295 -0.0515 0.07150" 
            quat="-1 0 0 -1" 
            size="0.014 0.014 0.0008 "/>

      <!-- Front ToF Site -->
      <site name="tof_front_site" 
            pos="0.075206 -0.0514149 0.0329529" 
            quat="0.5 0.5 0.5 0.5" 
            size="0.002" 
            rgba="1 0 0 1"/>

      <!-- Left ToF Site -->
      <site name="tof_left_site" 
            pos="0.064132 -0.0154935 0.0329529" 
            quat="0.331967 0.331967 0.624338 0.624338" 
            size="0.002" 
            rgba="1 0 0 1"/>

      <!-- Right ToF Site -->
      <site name="tof_right_site" 
            pos="0.0642998 -0.0873876 0.0329529" 
            quat="0.624338 0.624338 0.331967 0.331967" 
            size="0.002" 
            rgba="1 0 0 1"/>
  
      <geom pos="0.0799822 -0.0515649 0.019" 
            quat="0.707107 0.707107 0 0" 
            type="mesh" 
            rgba="0.796078 0.823529 0.937255 1" 
            mesh="caster_link" 
            friction="0.001 0.0001 0.0001"/>
            
      <!-- Right Wheel Body with Joint -->
      <body name="right_wheel_link" pos="0.0295396 -0.0865649 0.0354529" quat="0.707107 0.707107 0 0">
        
        <inertial pos="0 0 0.00357122" 
                  quat="0.5 0.5 -0.5 0.5" 
                  mass="0.00784958" 
                  diaginertia="1.22063e-06 6.46389e-07 6.46389e-07"/>

        <!-- FIX 1: Aligned joint axis polarity with body quaternion orientation -->
        <joint name="right_wheel_joint" 
               type="hinge" 
               axis="0 0 -1" 
               damping="0.001" 
               frictionloss="0.001"
               armature="4.5e-5"/>

        <geom type="mesh" 
              mesh="right_wheel_link" 
              rgba="0.1 0.1 0.1 1.0"
              contype="0" 
              conaffinity="0"/>

        <geom type="cylinder" 
              size="0.017 0.004" 
              rgba="1 0 0 0" 
              contype="1" 
              conaffinity="1" 
              friction="0.8 0.005 0.0001"/>
      </body>

      <!-- Left Wheel Body with Joint -->
      <body name="left_wheel_link" pos="0.0295396 -0.00856491 0.0354529" quat="0 0 0.707107 0.707107">
        
        <inertial pos="0 0 -0.00442878" 
                  quat="0.5 0.5 -0.5 0.5" 
                  mass="0.00784958" 
                  diaginertia="1.22063e-06 6.46389e-07 6.46389e-07"/>

        <joint name="left_wheel_joint" 
               type="hinge" 
               axis="0 0 1" 
               damping="0.001" 
               frictionloss="0.001"
               armature="4.5e-5"/>
       
        <!-- Render STL Visual Mesh (No Contact Collision) -->
        <geom type="mesh" 
              mesh="left_wheel_link" 
              rgba="0.1 0.1 0.1 1.0"
              contype="0" 
              conaffinity="0"/>
        
        <!-- Smooth Physics Cylinder (Diameter 34mm / Radius 17mm) -->
        <geom type="cylinder" 
              size="0.017 0.004" 
              rgba="1 0 0 0" 
              contype="1" 
              conaffinity="1" 
              friction="0.8 0.005 0.0001"/>
      </body>

    </body>
  </worldbody>

  <!-- Velocity Actuators for smooth wheel motion -->
  <actuator>
    <velocity name="left_motor" 
              joint="left_wheel_joint" 
              gear="0.05" 
              ctrlrange="-1 1"/>
              
    <velocity name="right_motor" 
              joint="right_wheel_joint" 
              gear="0.05" 
              ctrlrange="-1 1"/>
  </actuator>

  <sensor>
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <magnetometer name="imu_mag" site="imu_site"/>
    <framequat name="imu_orientation" objtype="site" objname="imu_site"/>

    <!-- ToF Distance Sensors (Outputs distance in meters along +Z axis) -->
    <rangefinder name="tof_front" site="tof_front_site" cutoff="1.0"/>
    <rangefinder name="tof_left" site="tof_left_site" cutoff="1.0"/>
    <rangefinder name="tof_right" site="tof_right_site" cutoff="1.0"/>

    <!-- Wheel encoders (joint position and velocity) -->
    <jointpos name="left_wheel_pos" joint="left_wheel_joint"/>
    <jointpos name="right_wheel_pos" joint="right_wheel_joint"/>
    <jointvel name="left_wheel_vel" joint="left_wheel_joint"/>
    <jointvel name="right_wheel_vel" joint="right_wheel_joint"/>
  </sensor>
</mujoco>